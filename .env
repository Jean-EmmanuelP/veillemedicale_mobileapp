# Config client publique (embarquée dans le bundle) — aucun secret ici.
EXPO_PUBLIC_CONVEX_URL=https://descriptive-rabbit-338.eu-west-1.convex.cloud
# Host HTTP de Convex (site) — dérivé automatiquement de CONVEX_URL si absent.
# Utilisé pour l'OAuth Google/LinkedIn (redirect vers <site>/api/auth/signin/google).
EXPO_PUBLIC_CONVEX_SITE_URL=https://descriptive-rabbit-338.eu-west-1.convex.site
